    <!-- Settings (Config) tab -->
    <string name="cfg_settings">Settings</string>
    <string name="cfg_gps_title">Tag packets with GPS position</string>
    <string name="cfg_gps_desc">When enabled, saving a received packet attaches GPS coordinates to the file.</string>
    <string name="cfg_gps_no_perm">No location permission — grant it to save GPS.</string>
    <string name="cfg_autoreconnect_title">Automatic reconnect</string>
    <string name="cfg_autoreconnect_desc">After an unexpected disconnect the app will try to reconnect to the RP2040 by itself.</string>
    <string name="cfg_theme_title">Colour theme</string>
    <string name="cfg_theme_desc">Changes the palette of the whole app.</string>
    <string name="cfg_gap_title">Inter-frame gap (TX)</string>
    <string name="cfg_gap_desc">Pause inserted between consecutive transmissions of a packet.</string>
    <string name="cfg_capture_title">OOK capture (monitor)</string>
    <string name="cfg_capture_desc">Frame detection for OOK captures: the shortest pulse kept (trims runts) and the LOW gap that ends a frame. Set the gap just above the longest LOW inside a frame and below the gap between repeats, so one capture = one complete frame. Needs firmware build 2+ (ignored by older firmware).</string>
    <string name="cfg_capture_min">Min pulse</string>
    <string name="cfg_capture_gap">Frame gap</string>
    <string name="cfg_capture_rssi">RSSI gate</string>
    <string name="cfg_capture_rssi_hint">Only capture when the signal is at or above −(this) dBm. Lower it in a quiet environment to catch weaker remotes; raise it where the noise floor is high.</string>
    <string name="mon_rssi_sub">Applied when you press Start</string>
    <string name="cfg_coalesce_title">Capture coalescing</string>
    <string name="cfg_coalesce_desc">Combine consecutive monitor captures of one transmission (repeats of the same frame, or a frame split across captures) into a single analysis. Captures more than the window apart are treated as separate signals.</string>
    <string name="cfg_coalesce_enable">Combine consecutive captures</string>
    <string name="cfg_coalesce_window">Group window</string>
