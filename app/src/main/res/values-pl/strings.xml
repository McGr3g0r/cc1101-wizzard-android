    <!-- Settings (Config) tab -->
    <string name="cfg_settings">Ustawienia</string>
    <string name="cfg_gps_title">Znakuj pakiety pozycją GPS</string>
    <string name="cfg_gps_desc">Gdy włączone, zapis odebranego pakietu dołącza współrzędne GPS do pliku.</string>
    <string name="cfg_gps_no_perm">Brak uprawnienia do lokalizacji — przyznaj je, aby zapisywać GPS.</string>
    <string name="cfg_autoreconnect_title">Automatyczne wznawianie połączenia</string>
    <string name="cfg_autoreconnect_desc">Po nieoczekiwanym rozłączeniu aplikacja sama spróbuje połączyć się z RP2040 ponownie.</string>
    <string name="cfg_theme_title">Szablon kolorystyczny</string>
    <string name="cfg_theme_desc">Zmienia paletę całej aplikacji.</string>
    <string name="cfg_gap_title">Odstęp między powtórzeniami (TX)</string>
    <string name="cfg_gap_desc">Pauza wstawiana między kolejnymi nadaniami pakietu.</string>
    <string name="cfg_capture_title">Przechwytywanie OOK (monitor)</string>
    <string name="cfg_capture_desc">Wykrywanie ramki dla przechwytów OOK: najkrótszy zachowywany impuls (ucina runty) oraz przerwa LOW kończąca ramkę. Ustaw przerwę tuż powyżej najdłuższego LOW w ramce, a poniżej przerwy między powtórzeniami — wtedy jedno przechwycenie = jedna pełna ramka. Wymaga firmware build 2+ (starsze ignorują te parametry).</string>
    <string name="cfg_capture_min">Min. impuls</string>
    <string name="cfg_capture_gap">Przerwa ramki</string>
    <string name="cfg_capture_rssi">Bramka RSSI</string>
    <string name="cfg_capture_rssi_hint">Przechwytuj tylko, gdy sygnał jest na poziomie −(tyle) dBm lub wyższym. Obniż w cichym otoczeniu, by łapać słabsze piloty; podnieś tam, gdzie poziom szumu jest wysoki.</string>
    <string name="mon_rssi_sub">Używane po naciśnięciu Start</string>
    <string name="cfg_coalesce_title">Łączenie przechwytów</string>
    <string name="cfg_coalesce_desc">Łączy kolejne przechwyty monitora z jednej transmisji (powtórzenia tej samej ramki lub ramkę rozbitą między przechwyty) w jedną analizę. Przechwyty odległe bardziej niż okno traktowane są jako osobne sygnały.</string>
